# 复制为 .env 后填写真实值。注意：已在终端 export 的变量会覆盖 .env 中的同名项。
# cp .env.example .env

# ---------- LLM（必填其一组合）----------
# provider: openai | deepseek | zhipu
MUTIAGENT_LLM_PROVIDER=openai

# OpenAI（或兼容网关）
OPENAI_API_KEY=
MUTIAGENT_LLM_MODEL=gpt-4.1-mini

# DeepSeek 示例（使用时改 provider 并填 key）
# MUTIAGENT_LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# MUTIAGENT_LLM_MODEL=deepseek-chat

# 智谱示例
# MUTIAGENT_LLM_PROVIDER=zhipu
# ZHIPU_API_KEY=
# MUTIAGENT_LLM_MODEL=glm-4-flash

# 自定义兼容 Base（一般可不设）
# MUTIAGENT_LLM_BASE_URL=

# 离线 / 不调 LLM（规则降级）
# MUTIAGENT_DISABLE_LLM=1

# ---------- 可选：日志与数据库 ----------
# MUTIAGENT_LOG_APPEND=1
# MUTIAGENT_DEBUG=1
# MUTIAGENT_DB_ENABLED=1
# MUTIAGENT_DB_PATH=log/mutiagent.sqlite3
