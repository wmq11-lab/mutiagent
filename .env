# MUTIAGENT_LLM_PROVIDER=openai
# OPENAI_API_KEY=your_api_key_here
# MUTIAGENT_LLM_MODEL=gpt-4.1-mini
# MUTIAGENT_LLM_BASE_URL=

# DeepSeek example:
MUTIAGENT_LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-03e05162eeb746e087ae22bf65ec6383
MUTIAGENT_LLM_MODEL=deepseek-chat
MUTIAGENT_LLM_BASE_URL=https://api.deepseek.com

# LLM 默认开启：不配下面这行即可。只有想强制关闭所有 LLM 调用时再取消注释：
# MUTIAGENT_DISABLE_LLM=1

# Zhipu example:
# MUTIAGENT_LLM_PROVIDER=zhipu
# ZHIPU_API_KEY=your_zhipu_key_here
# MUTIAGENT_LLM_MODEL=glm-4-flash
# MUTIAGENT_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

#日志文件
MUTIAGENT_DEBUG=1

# 数据库
MUTIAGENT_DB_ENABLED=1

# 被测仓库（无 bugsinpy）自动 venv：默认用启动 mutiagent 的 Python；Django 6 等需 ≥3.12。本机检测到 Anaconda 3.13：
MUTIAGENT_VENV_PYTHON=/opt/anaconda3/bin/python3.13
# 若改用 MUTIAGENT_PYTEST_PYTHON，将跳过自动 venv（不会在数据集里 pip install）。